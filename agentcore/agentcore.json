{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "adkAgent",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "adkAgent"
  },
  "runtimes": [
    {
      "name": "bug_fixer",
      "build": "Container",
      "entrypoint": "agentcore_runtime.ts",
      "codeLocation": "./",
      "runtimeVersion": "NODE_22",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "BEDROCK_MODEL", "value": "bedrock/us.anthropic.claude-sonnet-4-6" }
      ],
      "additionalPolicies": [
        "agentcore-bedrock-policy.json"
      ]
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}