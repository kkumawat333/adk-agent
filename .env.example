# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
#   cp .env.example .env
#
# `.env` is git-ignored because it holds credentials. This example file only
# documents which variables the agent reads — it contains no secrets.

# --- Gemini (optional) ---
# Only needed if you run an ADK flow against Gemini instead of Bedrock.
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# --- Amazon Bedrock ---
# Region where your Bedrock model access is enabled (per-account, per-region).
AWS_REGION="us-east-1"

# Your 12-digit AWS account ID. Used as the AgentCore CDK deployment target
# account: agentcore/cdk/bin/cdk.ts substitutes this into the placeholder
# account in agentcore/aws-targets.json at synth time, so the real account ID
# lives only in your git-ignored .env and is never committed.
AWS_ACCOUNT_ID="123456789012"

# AWS profile used for SigV4 auth (default credential chain). Deliberately NOT
# named AWS_PROFILE so a shell-exported AWS_PROFILE cannot silently shadow it.
# Configure this profile in ~/.aws/config (e.g. an SSO profile).
BEDROCK_AWS_PROFILE="your-aws-profile-name"

# Bedrock model id / inference profile, WITH the `bedrock/` prefix (the
# connector strips it). Newer Claude models require a cross-region inference
# profile ("us." / "global." prefix) rather than the bare model id.
BEDROCK_MODEL="bedrock/us.anthropic.claude-sonnet-4-6"

# Do NOT set AWS_BEARER_TOKEN_BEDROCK unless your IAM principal is explicitly
# granted `bedrock:CallWithBearerToken`. If set, the SDK uses bearer-token auth
# exclusively and ignores your SigV4 credentials. Leave it unset to use SigV4.
# AWS_BEARER_TOKEN_BEDROCK=
